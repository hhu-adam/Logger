{
  "id": null,
  "uid": "logger-operations",
  "title": "Lean4Game · Betrieb",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "weekStart": "monday",
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "hidden": false
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Umgebung",
        "type": "custom",
        "query": "production,development",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "development",
            "value": "development",
            "selected": false
          }
        ]
      },
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "title": "Nutzung & Berichte",
      "url": "/d/logger-usage",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Spielestatus",
      "url": "/d/logger-games",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Betrieb",
      "url": "/d/logger-operations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Einordnung · UTC",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Erreichbarkeit und letzte erfolgreiche Jobs. Ein erreichbarer Exporter garantiert keine aktuellen Messungen. Prüfe das Alter der Usage-Messung und der Länderübersetzung."
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Prometheus scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "up{job=\"logger\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Prometheus reports 1 when it can scrape Logger and 0 when the scrape fails. This replaces logger_service_up, which disappears when the endpoint is unreachable.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Activity refresh age",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - logger_job_last_success_timestamp_seconds{exported_job=\"game_activity_refresh\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Time since Logger last refreshed game lifecycle data. Orange after 5 minutes; red after 15.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Job failures in selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (environment) (increase(logger_job_failures_total{environment=~\"$environment\"}[$__range])) or on (environment) (0 * max by (environment) (up{job=\"logger\",environment=~\"$environment\"}))",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Failed Logger job attempts over the selected range. Shows zero while no failure counter has been created.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Time since each successful job",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - logger_job_last_success_timestamp_seconds{environment=~\"$environment\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "description": "The exported_job label is the Logger job name; job=logger is the Prometheus scrape target.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Alter der letzten Usage-Messung",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - logger_usage_last_measurement_timestamp_seconds{environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Time since Logger last refreshed game lifecycle data. Orange after 5 minutes; red after 15.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Alter der letzten Länderübersetzung",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - logger_job_last_success_timestamp_seconds{exported_job=\"location_translation\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Time since Logger last refreshed game lifecycle data. Orange after 5 minutes; red after 15.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 145,
      "type": "stat",
      "title": "Alter der letzten gültigen CPU-Messung",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 660
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "noValue": "Noch keine gültige Messung"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "time() - (logger_usage_cpu_last_success_timestamp_seconds{environment=~\"$environment\"} > 0)",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Zeit seit der letzten CPU-Messung mit frischen Quelldaten und vollständigem Zehn-Minuten-Fenster. Vor der ersten gültigen CPU-Messung keine Daten. Orange nach elf Minuten, rot nach fünfzehn.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    }
  ],
  "tags": [
    "Lean4Game",
    "Logger"
  ],
  "annotations": {
    "list": []
  }
}
