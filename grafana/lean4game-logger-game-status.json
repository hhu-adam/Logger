{
  "id": null,
  "uid": "logger-games",
  "title": "Lean4Game · Spielestatus",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "weekStart": "monday",
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "hidden": false
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Umgebung",
        "type": "custom",
        "query": "production,development",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "development",
            "value": "development",
            "selected": false
          }
        ]
      },
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "title": "Nutzung & Berichte",
      "url": "/d/logger-usage",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Spielestatus",
      "url": "/d/logger-games",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Betrieb",
      "url": "/d/logger-operations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Einordnung · UTC",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Status folgt der letzten Import-, Spiel- oder Erfassungsaktivität und den konfigurierten Fristen. **lastPlayedAt** ist ein eigener Zeitstempel. Löschberechtigung bedeutet nicht, dass ein Spiel gelöscht wurde."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active games",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "logger_game_lifecycle_games{status=\"active\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Games inside the configured activity window; not currently connected players.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Automatic cleanup",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "green"
                },
                "1": {
                  "text": "Enabled",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "logger_game_cleanup_enabled{environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "description": "Cleanup execution is disabled when the value is 0. Lifecycle classification still runs.",
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Games by lifecycle status",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "logger_game_lifecycle_games{environment=~\"$environment\"}",
          "legendFormat": "{{environment}} / {{status}}",
          "refId": "A",
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Each installed game is active, inactive, or deletion-due. Lifecycle data refreshes every 5 minutes; cleanup remains separate.",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Current status of each game",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "logger_game_lifecycle_info{environment=~\"$environment\"} == 1",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "description": "Latest status by game and environment. A deletion-due status does not itself delete a game.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Last played by game",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Zuletzt gespielt · UTC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Kein Zeitstempel erfasst"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sort_desc(logger_game_lifecycle_last_played_timestamp_seconds{environment=~\"$environment\"} * 1000)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "description": "lastPlayedAt aus den Spielmetadaten. Fehlender Zeitstempel bedeutet nicht, dass dieses Spiel nie gespielt wurde.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Zuletzt gespielt · UTC"
            }
          }
        }
      ]
    },
    {
      "id": 30,
      "type": "table",
      "title": "Inaktiv ab · je Spiel",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Inaktiv ab · UTC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Kein Zeitstempel erfasst"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sort_desc(logger_game_lifecycle_inactive_at_timestamp_seconds{environment=~\"$environment\"} * 1000)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "description": "Inaktivitätsfrist aus der letzten Aktivität und der konfigurierten Richtlinie.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Inaktiv ab · UTC"
            }
          }
        }
      ]
    },
    {
      "id": 31,
      "type": "table",
      "title": "Löschberechtigt ab · je Spiel",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Löschberechtigt ab · UTC"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Kein Zeitstempel erfasst"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sort_desc(logger_game_lifecycle_deletion_due_at_timestamp_seconds{environment=~\"$environment\"} * 1000)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "description": "Frist für Löschberechtigung aus den Aktivitätsmetadaten. Das Überschreiten löst nicht selbst eine Löschung aus.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Löschberechtigt ab · UTC"
            }
          }
        }
      ]
    }
  ],
  "tags": [
    "Lean4Game",
    "Logger"
  ],
  "annotations": {
    "list": []
  }
}
